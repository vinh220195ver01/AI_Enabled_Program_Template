#!/bin/sh
# Installed by install_hooks.py. Output is intentionally visible.
# Order: safety scan first; memory is only pushed if the scan passes.
[ "$SAFETY_SCAN_COMMITTING" = "1" ] && exit 0        # our own log commit
[ "$(git log -1 --format=%s)" = "chore: append safety-scan record" ] && exit 0  # amend of it
ROOT="$(git rev-parse --show-toplevel)"
if python "$ROOT/scripts/scan_memory.py" --commit; then
  python "$ROOT/.claude/skills/memory-backup/scripts/backup_memory.py" || true
else
  echo "[memory-backup] NOT pushed: safety scan found issues in memory/. Fix them (see MEMORY_CHECKLIST.md) and commit again."
fi
exit 0
